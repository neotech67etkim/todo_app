rules_version = '2';

// 프로토타입용 규칙: 인증 없이 누구나 읽고 쓸 수 있습니다.
// 실제 서비스로 배포하기 전에는 반드시 Firebase Authentication을 붙이고
// request.auth 기반으로 접근을 제한하세요.
service cloud.firestore {
  match /databases/{database}/documents {
    match /lists/{listId} {
      allow read, write: if true;
    }
    match /todos/{todoId} {
      allow read, write: if true;
    }
  }
}
